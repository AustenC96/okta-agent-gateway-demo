# Copy to .env and fill in. .env is gitignored; never commit it.

# Your Okta demo org, e.g. https://your-demo.oktapreview.com
OKTA_ORG_URL=

# Deployment Data -> gatewayUrl on the Agent Gateway component
GATEWAY_URL=

# Credentials panel on the Agent Gateway component (the AI agent's OAuth client)
CLIENT_ID=
CLIENT_SECRET=

PORT=8080

# Optional: an Okta API token (SSWS) that can read the System Log. Only used to turn the
# "Okta token exchange" and "GitHub token" stages green from real log evidence.
# Without it the demo works and those two stages stay blue ("inferred").
# OKTA_API_TOKEN=
