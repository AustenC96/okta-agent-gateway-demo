# Copy to .env and fill in. .env is gitignored: never commit it, and never paste its contents into chat or tickets.
# docs/SETUP.md says where each value comes from. Most of the agent values are printed for you by:  npm run okta -- env

# ---------- Okta ----------
# Your Okta org, e.g. https://your-org.okta.com or https://your-org.oktapreview.com (no trailing slash)
OKTA_ORG_URL=
# An API token (SSWS) created by a SUPER_ADMIN. Used by `npm run okta`, `npm run preflight`, and by the app to read the System Log
# so the "Okta token exchange" evidence turns green. Use a sandbox org and revoke the token when you are finished.
OKTA_API_TOKEN=

# ---------- the three agents (printed by `npm run okta -- env`) ----------
# Engineering: the gateway URL and the Engineering Agent's OAuth client
GATEWAY_URL=
CLIENT_ID=
CLIENT_SECRET=
# Sales and HR agents (their gateways live on the same host as GATEWAY_URL, at /mcp/servers/sales-tools and /hr-resources)
SALES_AGENT_CLIENT_ID=
SALES_AGENT_CLIENT_SECRET=
HR_AGENT_CLIENT_ID=
HR_AGENT_CLIENT_SECRET=

# ---------- AWS (printed by infra/deploy.sh; identifiers, not passwords) ----------
AWS_REGION=us-east-1
# The https URL of the API Gateway that fronts both MCP servers
MCP_API_BASE=
DB_CLUSTER_ARN=
DB_SECRET_ARN=
# Only if you renamed the stack's database
# DB_CLUSTER_ID=demo-db

# ---------- GitHub App for the Engineering team (only used by `npm run okta -- connect`) ----------
# GITHUB_APP_CLIENT_ID=
# GITHUB_APP_CLIENT_SECRET=

# ---------- optional ----------
PORT=8080
